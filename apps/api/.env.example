# Application
NODE_ENV=development
APP_NAME=bestal
APP_URL=http://localhost:3000
PORT=3000
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://bestal:bestal@localhost:5432/bestal?schema=public

# Auth
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
COOKIE_SECRET=change-me-cookie-secret

# Password reset token expiry
PASSWORD_RESET_EXPIRY=1h

# Storage — API uploads files to S3 (or local) on behalf of the client
STORAGE_DRIVER=s3
LOCAL_STORAGE_PATH=./uploads

# AWS S3 (required when STORAGE_DRIVER=s3)
# Must match the bucket region (amnets3bucket is us-east-2)
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=amnets3bucket
# Used for signed download URLs when serving private objects
S3_PRESIGNED_URL_EXPIRY=3600
# Optional overrides (SDK follows region redirects by default)
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# Mail (Gmail App Password recommended)
FROM_MAIL=
FROM_MAIL_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
WEB_APP_URL=http://localhost:5173

# Optional Python AI — leave unset to use hardcoded static extraction JSON.
# Upload to S3 + document.file_url in DB still run for every resume.
# Docker publish is often -p 8001:8000 (host 8001 → container 8000).
AI_EXTRACTION_URL=http://localhost:8001/api/v1/ai/resume/analyze
